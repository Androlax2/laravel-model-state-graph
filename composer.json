{
  "name": "androlax2/laravel-model-state-graph",
  "description": "This is my package laravel-model-state-graph",
  "keywords": [
    "laravel",
    "laravel-model-state-graph"
  ],
  "homepage": "https://github.com/androlax2/laravel-model-state-graph",
  "license": "MIT",
  "authors": [
    {
      "name": "Théo Benoit",
      "email": "theo.benoit16@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "canvural/larastan-strict-rules": "^2.0||^3.0",
    "driftingly/rector-laravel": "^1.0|^2.0",
    "larastan/larastan": "^2.0||^3.0",
    "laravel/pint": "^1.14",
    "nunomaduro/collision": "^8.8",
    "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
    "pestphp/pest": "^2.0|^3.7|^4.0",
    "pestphp/pest-plugin-arch": "^2.0|^3.7|^4.0",
    "pestphp/pest-plugin-laravel": "^2.0|^3.7|^4.0",
    "pestphp/pest-plugin-type-coverage": "^2.0|^3.7|^4.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "rector/rector": "^1.0|^2.0",
    "symfony/var-dumper": "^6.0|^7.0"
  },
  "autoload": {
    "psr-4": {
      "Androlax\\LaravelModelStateGraph\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@composer run prepare",
      "@composer run setup:node"
    ],
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "setup:node": "npm install || echo 'Node.js not installed, skipping cspell setup'",
    "refactor": "rector",
    "lint": "pint --parallel",
    "test:refactor": "rector --dry-run",
    "test:lint": "pint --parallel --test",
    "test:types": "phpstan analyse --ansi --memory-limit=2G",
    "test:spell": "npx cspell \"**/*.php\" \"**/*.md\" \"**/*.json\" \"**/*.yml\"",
    "test:unit": "pest --colors=always tests/Unit --parallel",
    "test:feature": "pest --colors=always tests/Feature --parallel",
    "test:types-coverage": "pest --type-coverage",
    "test:coverage": "pest --colors=always --coverage --parallel",
    "test": [
      "@test:refactor",
      "@test:lint",
      "@test:types",
      "@test:spell",
      "@test:unit",
      "@test:feature",
      "@test:types-coverage"
    ],
    "format": [
      "@refactor",
      "@lint"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Androlax\\LaravelModelStateGraph\\LaravelModelStateGraphServiceProvider"
      ],
      "aliases": {
        "LaravelModelStateGraph": "Androlax\\LaravelModelStateGraph\\Facades\\LaravelModelStateGraph"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
